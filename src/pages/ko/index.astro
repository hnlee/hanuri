---
import "../../styles/global.css";
import Footer from "../../components/footer.astro";
import Hamburger from "../../components/hamburger.astro";
import Hero from "../../components/hero.astro";
import Menu from "../../components/menu.astro";
import { Content as AboutUs } from "../../components/ko/aboutUs.md";
import { Content as Donate } from "../../components/ko/donate.md";
import { Content as ProgramInformation } from "../../components/ko/programInformation.md";
import { Content as Registration } from "../../components/ko/registration.md";
import { Content as WhyHanuri } from "../../components/ko/whyHanuri.md";
import Logo from "../../assets/hanuri_horizontal_logo.svg";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="content-language" content="ko" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" href="favicon.icns" />
    <link rel="icon" href="favicon.ico" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="한우리 한국학교" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://www.hanurikoreanschool.org/thumbnail-ko.png" />
    <meta property="og:url" content="https://www.hanurikoreanschool.org/ko/" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:description" content="시카고에 5 ~ 18세 어린이 대상 한국학교" />
    <meta name="description" content="시카고에 5 ~ 18세 어린이 대상 한국학교" />
    <title>한우리 한국학교</title>
  </head>
  <body>
    <header>
      <section id="header-section">
        <Logo preserveAspectRatio="xMinYMid" />
        <nav id="header-menu"><Menu /></nav>
      </section>
    </header>
    <main>
      <Hero />
      <Hamburger />
      <section class="content"><article><WhyHanuri /></article></section>
      <section class="content"><article><ProgramInformation /></article></section>
      <section class="content">
        <article>
          <Registration />
        </article>
      </section>
      <section class="content"><article><AboutUs /></article></section>
      <section class="content"><article><Donate /></article></section>
    </main>
  </body>
  <Footer />
</html>
