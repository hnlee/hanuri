---
import Logo from "../assets/hanuri_horizontal_logo.svg";

interface MenuItem {
  id: string;
  text: string;
};

const menuItems: MenuItem[] = [
  {
    id: "#program-information",
    text: "Program Info"
  },
  {
    id: "#registration",
    text: "Registration"
  },
  {
    id: "#why-hanuri-korean-school",
    text: "Why Hanuri"
  },
  {
    id: "#about-us",
    text: "About Us"
  },
  {
    id: "#donate",
    text: "Donate"
  }
];
---
<nav>
  <menu>
    {menuItems.map((item) => <li><a class="nav-link" href={item.id}>{item.text}</a></li>)}
  </menu>
</nav>
