---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslation } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslation(lang);

interface MenuItem {
  id: string;
  text: string;
}

const menuItems: MenuItem[] = [
  {
    id: t("menu.why-hanuri.id"),
    text: t("menu.why-hanuri.text"),
  },
  {
    id: t("menu.program-info.id"),
    text: t("menu.program-info.text"),
  },
  {
    id: t("menu.registration.id"),
    text: t("menu.registration.text"),
  },
  {
    id: t("menu.about-us.id"),
    text: t("menu.about-us.text"),
  },
  {
    id: t("menu.donate.id"),
    text: t("menu.donate.text"),
  },
];
---

<menu>
  <li>
    <a href="../en/index.html"
      ><Icon class="language-picker" name="openmoji:flag-united-states" /></a
    >
    &nbsp;
    <a href="../ko/index.html"><Icon class="language-picker" name="openmoji:flag-south-korea" /></a>
  </li>
  {
    menuItems.map((item) => (
      <li>
        <a class="nav-link" href={item.id}>
          {item.text}
        </a>
      </li>
    ))
  }
</menu>
